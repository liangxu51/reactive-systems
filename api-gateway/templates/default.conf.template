# The single source of truth for the /api/* routing table. Rendered into
# /etc/nginx/conf.d/default.conf at container start by the stock nginx image's
# envsubst entrypoint (20-envsubst-on-templates.sh): ${VAR} placeholders are
# substituted from the environment, while $var stays an nginx runtime
# variable. The Helm chart runs this same image with cluster-appropriate env
# values (see templates/api-gateway.yaml) - there is deliberately no
# Kubernetes copy of this file to keep in sync.
#
# API_AUTH_B64 is not set by the operator - it is derived from
# API_AUTH_USERNAME/API_AUTH_PASSWORD by docker-entrypoint.d/15-encode-basic-auth.sh
# before this template is rendered.

# Rate-limit only order *submissions*. GET /api/orders is the SSE stream -
# rate-limiting it would kill long-lived dashboard connections - so the limit
# key is empty (= exempt) for everything but POST.
map $request_method $orders_post_key {
    default "";
    POST    $binary_remote_addr;
}
limit_req_zone $orders_post_key zone=orders_post:1m rate=5r/s;

# Honor a caller-supplied X-Request-ID, else mint one from nginx's built-in
# per-request hex ID, so every hop (and the JSON access log below) can be
# correlated.
map $http_x_request_id $req_id {
    default $http_x_request_id;
    ""      $request_id;
}

# One flat JSON object per request, matching the backends' JSON-to-stdout
# logging (#47) so Promtail ingests gateway logs with no new pipeline work.
log_format gateway_json escape=json
    '{"time":"$time_iso8601",'
    '"request_id":"$req_id",'
    '"client":"$remote_addr",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"request_time":$request_time,'
    '"upstream_response_time":"$upstream_response_time",'
    '"upstream":"$upstream_addr",'
    '"bytes_sent":$body_bytes_sent}';

server {
    listen 8080;
    server_name _;

    access_log /var/log/nginx/access.log gateway_json;

    # Resolve upstreams lazily per-request (variable proxy_pass + resolver)
    # instead of once at startup, so the gateway boots and serves 502s even
    # while the profile-gated order-service variant isn't running yet.
    # 127.0.0.11 is Docker's embedded DNS; Helm overrides with the cluster
    # DNS Service IP.
    resolver ${RESOLVER} valid=10s;

    proxy_connect_timeout 5s;
    proxy_set_header X-Request-ID $req_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    # The browser cannot authenticate (EventSource can't send headers, and the
    # UI holds no credential), so the gateway terminates auth at the edge and
    # calls the backends with the shared API service credential. Backends
    # still enforce Basic auth themselves, so direct (non-gateway) access
    # keeps returning 401.
    proxy_set_header Authorization "Basic ${API_AUTH_B64}";

    add_header X-Request-ID $req_id always;

    location /api/orders {
        set $order_upstream ${ORDER_UPSTREAM};
        proxy_pass http://$order_upstream$request_uri;

        limit_req zone=orders_post burst=10 nodelay;
        limit_req_status 429;

        # SSE kit for the GET /api/orders text/event-stream response:
        # unbuffered so each event is forwarded as it arrives, a long read
        # timeout so the stream isn't cut, HTTP/1.1 with the Connection
        # header cleared for a persistent upstream connection. POST shares
        # these settings harmlessly (it completes in milliseconds).
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_read_timeout 1h;

        # nginx proxy_set_header inheritance is all-or-nothing: the
        # Connection directive above cancels every server-level
        # proxy_set_header for this location, so the shared set must be
        # repeated here - dropping these silently drops the injected
        # Authorization header and turns this route into a 401.
        proxy_set_header X-Request-ID $req_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Authorization "Basic ${API_AUTH_B64}";
    }

    location /api/products {
        set $inventory_upstream ${INVENTORY_UPSTREAM};
        proxy_pass http://$inventory_upstream$request_uri;
        proxy_read_timeout 30s;
    }

    # Default deny: only the /api/* locations above are exposed. Backend
    # swagger-ui/actuator stay internal (docker compose exec / kubectl
    # port-forward for those).
    location / {
        return 404;
    }
}
