<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrderService.Api</RootNamespace>
    <AssemblyName>OrderService.Api</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.15.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

  <!-- The default SDK globs pick up every *.cs file under this directory,
       including the test project's and the dev launcher's - exclude them so
       the projects don't double-compile each other's sources. -->
  <ItemGroup>
    <Compile Remove="order-service-cs.Tests/**/*.cs" />
    <Content Remove="order-service-cs.Tests/**/*" />
    <None Remove="order-service-cs.Tests/**/*" />
    <Compile Remove="OrderService.DevHost/**/*.cs" />
    <Content Remove="OrderService.DevHost/**/*" />
    <None Remove="OrderService.DevHost/**/*" />
  </ItemGroup>

</Project>
